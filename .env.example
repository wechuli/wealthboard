# Configuration reference: the Go binary reads exported variables, not .env.
# Compose reads .env for interpolation and also requires POSTGRES_PASSWORD.
# Required Go/PostgreSQL runtime database.
DATABASE_URL=postgres://wealthboard:wealthboard@localhost:5433/wealthboard?sslmode=disable
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3000
# Use production outside local development so session cookies require HTTPS.
NODE_ENV=development
PORT=3000
# Legacy setting, ignored by the Go runtime. Rate limits use the socket peer
# IP even behind a proxy; forwarding headers do not change the limit key.
TRUST_PROXY_HEADERS=false
# Authentication policy: local, oidc, or local,oidc.
AUTH_METHODS=local
# Required only when AUTH_METHODS includes oidc. OIDC_ISSUER may include a
# Keycloak realm path, but no query string or fragment.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=
# Generate with: openssl rand -base64 32
OIDC_TRANSACTION_SECRET=
TZ=Africa/Nairobi
# Optional: enables encrypted per-user provider credentials.
# Generate with: openssl rand -base64 32
AI_CREDENTIAL_ENCRYPTION_KEY=
# Built Vite client served by the Go process.
WEB_DIST_PATH=web/dist
