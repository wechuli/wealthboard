# Required Go/PostgreSQL runtime database.
DATABASE_URL=postgres://wealthboard:wealthboard@localhost:5433/wealthboard?sslmode=disable
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3000
# Use production outside local development so session cookies require HTTPS.
NODE_ENV=development
PORT=3000
# Enable only behind one trusted ingress that overwrites forwarding headers
# with one client IP and strips client-supplied forwarding headers.
TRUST_PROXY_HEADERS=false
# Authentication policy: local, oidc, or local,oidc.
AUTH_METHODS=local
# Required only when AUTH_METHODS includes oidc. OIDC_ISSUER may include a
# Keycloak realm path, but no query string or fragment.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=
# Generate with: openssl rand -base64 32
OIDC_TRANSACTION_SECRET=
TZ=Africa/Nairobi
# Optional: enables encrypted per-user provider credentials.
# Generate with: openssl rand -base64 32
AI_CREDENTIAL_ENCRYPTION_KEY=
# Optional comma-separated exact URLs for custom OpenAI-compatible endpoints.
AI_ALLOWED_ENDPOINTS=
# Optional Unix socket for the isolated PDF/XLSX/DOCX extraction worker.
AI_EXTRACTION_SOCKET=
# Direct-install fallback only; requires Node.js and is absent from the
# distroless application image.
AI_EXTRACTION_SCRIPT=scripts/extract-import-source-cli.mjs
# Built Vite client served by the Go process.
WEB_DIST_PATH=web/dist
