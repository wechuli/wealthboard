{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wealthboard.local/schemas/account-history-v1.schema.json",
  "title": "Wealthboard Account History Import v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "transactions"],
  "properties": {
    "format": { "const": "wealthboard-account-history" },
    "version": { "const": 1 },
    "transactions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["external_id", "type", "amount", "date"],
        "properties": {
          "external_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "type": {
            "enum": [
              "deposit",
              "withdrawal",
              "interest",
              "dividend",
              "capital_gain",
              "capital_loss",
              "fee",
              "purchase",
              "sale",
              "manual_adjustment",
              "liability_payment",
              "liability_increase"
            ]
          },
          "amount": {
            "type": "string",
            "pattern": "^-?\\d+(?:\\.\\d+)?$"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "description": {
            "type": ["string", "null"],
            "maxLength": 200
          },
          "notes": {
            "type": ["string", "null"],
            "maxLength": 2000
          }
        }
      }
    }
  }
}
